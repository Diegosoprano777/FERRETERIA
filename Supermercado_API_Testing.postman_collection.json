{
	"info": {
		"_postman_id": "c1f2e3d4-5678-4901-abcd-ef1234567890",
		"name": "Supermercado_API_Testing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "POST Autenticacion Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"pm.test(\"Validar JSON Schema de Token Auth\", function () {",
							"    var schema = {",
							"        \"type\": \"object\",",
							"        \"required\": [\"token\"],",
							"        \"properties\": {",
							"            \"token\": { \"type\": \"string\" }",
							"        }",
							"    };",
							"    pm.response.to.have.jsonSchema(schema);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.environment.set(\"user_token\", jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"Diego\",\n  \"password\": \"Diego12345\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url_base}}/api/v1/auth/",
					"host": [
						"{{url_base}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						""
					]
				}
			},
			"response": []
		},
